{
  "schema": "leeway-voice-fabric/v2",
  "authority": "4citeB4U/LeeWay-Voice-Fabric",
  "purpose": "canonical multi-agent voice package registry and speech service",
  "defaultVoice": "agent-lee-voice-one",
  "transport": [
    "iframe-postMessage",
    "direct-browser",
    "runtime-fabric-adapter"
  ],
  "voicePackage": {
    "required": [
      "id",
      "name",
      "owner",
      "provider",
      "pace",
      "exaggeration"
    ],
    "reference": "versioned URL or Voice Fabric origin IndexedDB blob",
    "bindingRule": "Every LeeWay agent or worker must have an explicit voicePackageId. Agent Lee Voice One is not the universal default for other agents."
  },
  "commands": {
    "ping": {},
    "listVoices": {},
    "getVoice": {
      "voicePackageId": "string"
    },
    "selectVoice": {
      "voicePackageId": "string"
    },
    "prepare": {
      "provider": "optional"
    },
    "configure": {
      "pace": "number",
      "exaggeration": "number",
      "provider": "string"
    },
    "setReference": {
      "audio": "ArrayBuffer"
    },
    "speak": {
      "text": "string"
    },
    "streamStart": {
      "streamId": "string"
    },
    "streamChunk": {
      "streamId": "string",
      "text": "string"
    },
    "streamEnd": {
      "streamId": "string"
    },
    "stop": {},
    "dispose": {},
    "metrics": {}
  },
  "invariants": [
    "voice package identity independent of reasoning model",
    "one audible lane",
    "stop voice without canceling upstream reasoning",
    "bounded queue",
    "ordered text",
    "stale audio suppressed after interruption",
    "voice ownership is explicit per agent or worker"
  ]
}